SERVICE_NAME=echoBridge
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
DATA_SOURCE_MODE=mock
MOCK_DATA_FILE=mock-data/sage-sample.json
SAGE_ALLOWED_TABLES=CUSTOMER,SALES_LEDGER,STOCK
SAGE_DEFAULT_LIMIT=100
SAGE_MAX_LIMIT=1000
AUTH_MODE=hmac
CONNECTOR_CLIENT_ID=supabase-edge
CONNECTOR_SHARED_SECRET=super-secret-for-local-dev-only
ALLOWED_CLOCK_SKEW_MS=300000
BODY_LIMIT_BYTES=32768
REQUEST_TIMEOUT_MS=30000
ENABLE_SQL_ENDPOINT=false
LOG_QUERY_TEXT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
TRUST_PROXY=false
