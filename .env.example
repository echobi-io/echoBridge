SERVICE_NAME=echoBridge
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
DATA_SOURCE_MODE=odbc
SAGE_ODBC_CONNECTION_STRING=DSN=SageLine50v28;UID=manager;PWD=your-password;
MOCK_DATA_FILE=mock-data/sage-sample.json
SAGE_ALLOWED_TABLES=CUSTOMER,SALES_LEDGER,STOCK
SAGE_DEFAULT_LIMIT=100
SAGE_MAX_LIMIT=1000
AUTH_MODE=hmac
CONNECTOR_CLIENT_ID=supabase-edge
CONNECTOR_SHARED_SECRET=replace-with-a-64-char-random-secret
ALLOWED_CLOCK_SKEW_MS=300000
BODY_LIMIT_BYTES=32768
REQUEST_TIMEOUT_MS=30000
ENABLE_SQL_ENDPOINT=false
LOG_QUERY_TEXT=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
TRUST_PROXY=false
# API_KEY=only-required-when-AUTH_MODE=api-key
